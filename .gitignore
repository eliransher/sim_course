# Python / IDE
__pycache__/
*.pyc
venv/
.venv/
.idea/
.ipynb_checkpoints/

# Office lock files
~$*

# lectures/notebooks: only the notebooks themselves
lectures/notebooks/*
!lectures/notebooks/*.ipynb

# assignments: no solutions, and no copies of the top-level Images/pkls
assignments/**/*solution*.ipynb
assignments/*/Images/
assignments/*/pkls/
